# No environment variables are required for BMKG JSON or OpenStreetMap.

# terma-iot (device intake) as seen from this web server, and its shared key (same as firmware secrets.h)
TERMA_IOT_URL=http://localhost:3028
TERMA_IOT_KEY=
# Signs login sessions; required in production (>= 32 characters)
TERMA_SESSION_SECRET=
# Shared workspace and password hashes; defaults to ~/.terma
TERMA_DATA_DIR=
