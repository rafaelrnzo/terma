      "css": ".ds-button-ghost{display:inline-flex;max-width:100%;min-height:44px;align-items:center;justify-content:center;gap:8px;padding:8px 16px;border:1px solid transparent;border-radius:var(--radius-sm,8px);font-family:var(--font-inter, Inter, sans-serif);font-size:14px;line-height:20px;font-weight:500;white-space:normal;text-align:center;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1);background:transparent;color:var(--foreground,#263a32);}.ds-button-ghost:hover{background:var(--muted,#eaf0ec);color:var(--foreground,#263a32);}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring,#31694c);box-shadow:0 0 0 3px var(--ring,#31694c);}.ds-button-ghost:active:not([aria-haspopup]){transform:translateY(1px)}.ds-button-ghost:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-ghost:active{transform:none}}"
    },
